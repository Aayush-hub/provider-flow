# Supabase project settings from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable/anon key. This key is safe for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server-only key for controlled administrative setup. Never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Defaults to true. Documented fictional identifiers use deterministic fixtures;
# every other checksum-valid NPI is looked up through live NPPES/CMS.
# Set false to disable fictional fixtures and allow live identifiers only.
NEXT_PUBLIC_DEMO_DATA_MODE=true
